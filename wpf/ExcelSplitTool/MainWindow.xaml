<Window x:Class="ExcelSplitTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExcelSplitTool.Models"
        Title="Excel 表格拆分工具"
        Width="980" Height="760" MinWidth="860" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBgBrush}"
        FontFamily="Microsoft YaHei UI">
    <DockPanel>
        <!-- 顶栏菜单（参照 phpEnv） -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="12,8">
            <DockPanel>
                <TextBlock Text="Excel 表格拆分工具" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <TextBlock Text="按列拆分 · 筛选 · 导出" Foreground="#E8F4FF" FontSize="12"
                           VerticalAlignment="Center" Margin="16,0,0,0" DockPanel.Dock="Left" />
                <Menu Background="Transparent" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <MenuItem Header="文件" Foreground="White">
                        <MenuItem Header="打开 Excel..." Click="BrowseFile_Click" />
                        <Separator />
                        <MenuItem Header="退出" Click="Exit_Click" />
                    </MenuItem>
                    <MenuItem Header="工具" Foreground="White">
                        <MenuItem Header="开始拆分" Click="RunSplit_Click" />
                        <MenuItem Header="打开输出目录" Click="OpenOutput_Click" IsEnabled="False" x:Name="MenuOpenOutput" />
                    </MenuItem>
                    <MenuItem Header="帮助" Foreground="White">
                        <MenuItem Header="关于" Click="About_Click" />
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- 底部操作区 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="输出方式" Width="72" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <RadioButton x:Name="RbModeFiles" Content="多个文件（文件夹）" IsChecked="True" Margin="8,0,16,0"
                                 Checked="OutputMode_Changed" GroupName="OutMode" />
                    <RadioButton x:Name="RbModeWorkbook" Content="单个工作簿（多工作表）"
                                 Checked="OutputMode_Changed" GroupName="OutMode" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输出位置" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="TxtOutputHint" IsReadOnly="True" Grid.Column="1" Margin="8,0,0,0"
                             Background="#F5F7FA" BorderBrush="{StaticResource BorderBrush}" />
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                    <Button x:Name="BtnRun" Content="开始拆分" Click="RunSplit_Click"
                            Style="{StaticResource BtnPrimary}" Width="120" Height="38"
                            DockPanel.Dock="Left" />
                    <TextBlock x:Name="TxtStatus" Text="请选择 Excel 文件" VerticalAlignment="Center"
                               Margin="20,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </DockPanel>
                <ProgressBar x:Name="ProgressSplit" Grid.Row="3" Height="8" Minimum="0" Maximum="100"
                             Visibility="Collapsed" Background="#EBEEF5"
                             Foreground="{StaticResource PrimaryBrush}" />
            </Grid>
        </Border>

        <!-- 快捷操作条（phpEnv 大图标区简化版） -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBgBrush}" Margin="16,12,16,0"
                CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 状态指示 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="16,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotFile" Width="10" Height="10" Fill="#C0C4CC" Margin="0,0,8,0" />
                            <TextBlock x:Name="LblFileStatus" Text="未加载文件" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotSheet" Width="10" Height="10" Fill="#C0C4CC" Margin="0,0,8,0" />
                            <TextBlock x:Name="LblSheetStatus" Text="无工作表" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- 快捷按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="选择文件" Click="BrowseFile_Click" Width="100" Height="36" Margin="4,0"
                            Style="{StaticResource BtnPrimary}" />
                    <Button Content="重新加载" Click="ReloadSheet_Click" Width="100" Height="36" Margin="4,0"
                            Style="{StaticResource BtnDefault}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容 -->
        <ScrollViewer Margin="16,12,16,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 文件与工作表 -->
                <Border Background="{StaticResource CardBgBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Excel 文件" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文件" VerticalAlignment="Center" Width="40" />
                            <TextBox x:Name="TxtFileName" Grid.Column="1" IsReadOnly="True" Margin="8,0"
                                     Background="#F5F7FA" />
                            <TextBlock Grid.Column="2" Text="工作表" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <ComboBox x:Name="CmbSheet" Grid.Column="3" Width="180" SelectionChanged="Sheet_Changed" />
                        </Grid>
                        <TextBlock x:Name="TxtPathHint" Margin="0,6,0,0" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 上排：拆分 | 筛选 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 按列拆分 -->
                    <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="200" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="按列拆分" FontWeight="Bold" FontSize="14" />
                            <TextBlock Grid.Row="1" Text="可多列组合；文件夹→多文件，工作簿→多工作表"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="拆分列" VerticalAlignment="Center" Width="48" />
                                <ComboBox x:Name="CmbSplitCol" Width="140" Margin="4,0" />
                                <Button Content="添加" Click="AddSplitCol_Click" Margin="4,0" Width="64"
                                        Style="{StaticResource BtnDefault}" />
                                <Button Content="移除" Click="RemoveSplitCol_Click" Width="64"
                                        Style="{StaticResource BtnDefault}" />
                            </StackPanel>
                            <ListBox x:Name="LstSplitCols" Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" />
                        </Grid>
                    </Border>
                    <!-- 筛选条件 -->
                    <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" Margin="6,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="200" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="筛选条件" FontWeight="Bold" FontSize="14" />
                            <TextBlock Grid.Row="1" Text="添加后设置条件（依列类型显示）"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="筛选列" VerticalAlignment="Center" Width="48" />
                                <ComboBox x:Name="CmbFilterCol" Width="140" Margin="4,0" />
                                <Button Content="添加" Click="AddFilter_Click" Margin="4,0" Width="64"
                                        Style="{StaticResource BtnDefault}" />
                                <Button Content="移除" Click="RemoveFilter_Click" Width="64"
                                        Style="{StaticResource BtnDefault}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FiltersPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 列类型 -->
                <Border x:Name="TypeCard" Background="{StaticResource CardBgBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="列类型" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                        <TextBlock Text="自动判断，可修正；影响筛选与导出格式" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="全部恢复自动判断" Click="ResetKinds_Click" Width="140"
                                    Style="{StaticResource BtnDefault}" Margin="0,0,12,0" />
                            <RadioButton x:Name="TabAll" Content="全部" IsChecked="True" GroupName="TypeTab"
                                         Checked="TypeTab_Changed" Margin="4,0" />
                            <RadioButton x:Name="TabText" Content="文本" GroupName="TypeTab" Checked="TypeTab_Changed" Margin="4,0" />
                            <RadioButton x:Name="TabDate" Content="日期" GroupName="TypeTab" Checked="TypeTab_Changed" Margin="4,0" />
                            <RadioButton x:Name="TabNumber" Content="数字" GroupName="TypeTab" Checked="TypeTab_Changed" Margin="4,0" />
                        </StackPanel>
                        <Border CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Background="#FAFBFC">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F5F7FA" Padding="12,8"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="108" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="列名" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="自动判断" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="修正为" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="TypeColumnList" AlternationCount="2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,7" BorderBrush="#EBEEF5" BorderThickness="0,0,0,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                                    Value="1">
                                                                    <Setter Property="Background" Value="#FAFBFC" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="88" />
                                                            <ColumnDefinition Width="108" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ColumnName}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding ColumnName}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding AutoLabel}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <ComboBox Grid.Column="2"
                                                                  ItemsSource="{x:Static models:ColumnKindLabels.All}"
                                                                  SelectedItem="{Binding CorrectedLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Style="{StaticResource TypeKindComboStyle}"
                                                                  SelectionChanged="KindCombo_SelectionChanged" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
