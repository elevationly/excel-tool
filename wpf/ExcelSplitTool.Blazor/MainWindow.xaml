<Window x:Class="ExcelSplitTool.Blazor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:ExcelSplitTool.Blazor.Components"
        Title="Excel 表格拆分工具"
        Height="820" Width="1100" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <blazor:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot\index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:App}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
